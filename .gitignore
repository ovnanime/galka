# Подпись приложения. Ключ и пароли не должны попасть в репозиторий:
# кто угодно сможет выпустить обновление от твоего имени.
*.jks
*.keystore
keystore.properties

# Среда разработки
.idea/
*.iml

# Система
.DS_Store
Thumbs.db
