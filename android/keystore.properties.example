# Скопируй этот файл рядом под именем keystore.properties и впиши свои значения.
# Настоящий keystore.properties и сам .jks в репозиторий не попадают — так задано в .gitignore.

storeFile=D:/Android/keys/galka-release.jks
storePassword=ЗДЕСЬ_ПАРОЛЬ_ХРАНИЛИЩА
keyAlias=galka
keyPassword=ЗДЕСЬ_ПАРОЛЬ_КЛЮЧА
